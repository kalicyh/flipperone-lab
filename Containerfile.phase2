FROM scratch

ADD artifacts/debian-ospack.tar.gz /

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1
ENV FLIPPER_UI_PORT=8899
ENV NOVNC_PORT=6080

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    chromium \
    dbus-x11 \
    iproute2 \
    nodejs \
    novnc \
    openbox \
    procps \
    websockify \
    x11vnc \
    xauth \
    xvfb \
 && rm -rf /var/lib/apt/lists/*

RUN if [ -d /flipperone-testing/fake-flipctl2 ]; then \
      ln -sfn /flipperone-testing/fake-flipctl2 /flipperone-testing/active-flipctl; \
    fi

COPY context/common/flipper-vnc-entrypoint.sh /usr/local/bin/flipper-vnc-entrypoint
RUN chmod +x /usr/local/bin/flipper-vnc-entrypoint

EXPOSE 6080 8899

ENTRYPOINT ["/usr/local/bin/flipper-vnc-entrypoint"]

