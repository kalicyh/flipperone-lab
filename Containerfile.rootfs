FROM scratch

ADD artifacts/debian-ospack.tar.gz /

ENV DEBIAN_FRONTEND=noninteractive
ENV FLIPPER_UI_PORT=8899

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    iproute2 \
    nodejs \
    procps \
 && rm -rf /var/lib/apt/lists/*

RUN if [ -d /flipperone-testing/fake-flipctl2 ]; then \
      ln -sfn /flipperone-testing/fake-flipctl2 /flipperone-testing/active-flipctl; \
    fi

COPY context/common/flipper-ui-entrypoint.sh /usr/local/bin/flipper-ui-entrypoint
COPY context/common/lab-overlay/ /opt/flipperone-lab-overlay/
COPY assets/flipperone-protopie/ /opt/flipperone-lab-assets/protopie/
RUN chmod +x /usr/local/bin/flipper-ui-entrypoint

EXPOSE 8899

ENTRYPOINT ["/usr/local/bin/flipper-ui-entrypoint"]
